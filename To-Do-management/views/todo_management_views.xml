<odoo>

    <record id="todo_management_view_tree" model="ir.ui.view">
        <field name="name">to do tree</field>
        <field name="model">to.do</field>
        <field name="arch" type="xml">
            <tree class="header_custom">
                <field name="task_name"/>
                <field name="due_date"/>
                <field name="assign_to"/>
            </tree>
        </field>
    </record>

    <record id="todo_management_view_search" model="ir.ui.view">
        <field name="name">to do search</field>
        <field name="model">to.do</field>
        <field name="arch" type="xml">
            <search>
                <field name="assign_to"/>
                <field name="task_name"/>

                <filter name="with_status" string="With Status" context="{'group_by': 'status'}"/>
                <filter name="with_assign_to" string="With Assign To" context="{'group_by': 'assign_to'}"/>
                <filter name="with_due_date" string="With Due Date" context="{'group_by': 'due_date'}"/>

                <filter name="new_p" string="New" domain="[('status', '=', 'new')]"/>

                <filter name="in_p" string="In Progress" domain="[('status', '=', 'in_progress')]"/>

                <filter name="c_p" string="Complete" domain="[('status', '=', 'complete')]"/>
            </search>

        </field>
    </record>



    <record id="todo_management_view_form" model="ir.ui.view">
        <field name="name">to do form</field>
        <field name="model">to.do</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_new" type="object" class="btn-danger" string="Set To New" invisible="status == 'new'"/>
                        <button name="action_in_progress" type="object" class="btn-warning" string="Set To In progress" invisible="status != 'new'"/>
                        <button name="action_complete" type="object" class="btn-success" string="Set To Complete" invisible="status != 'in_progress'"/>
                        <field name="status" widget="statusbar" options="{'clickable': True}"/>
                    </header>

                    <div class = "oe_title">
                        <label for="task_name"/>
                        <h1>
                            <field name="task_name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="due_date"/>
                            <field name="user_id"/>
                        </group>

                        <group>
                            <field name="description" required="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="todo_management_action" model="ir.actions.act_window">
        <field name="name">To Do</field>
        <field name="res_model">to.do</field>
        <field name="view_mode">tree,form</field>

    </record>
    <menuitem
        id="todo_management_menu_item"
        name="to do"
        parent="to_do_menu"
        action="todo_management_action"
    />
</odoo>
